server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 10M;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Hashed build assets: cache forever, and 404 (never index.html) if a
  # chunk from an older deploy is requested.
  location /assets/ {
    try_files $uri =404;
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # index.html (and SPA routes) must never be cached, so browsers always
  # get the current chunk hashes after a redeploy.
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
  }
}
